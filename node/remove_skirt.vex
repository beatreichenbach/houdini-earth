float dotThreshold = chf("DotThreshold");
float switchThreshold = chf("SwitchThreshold");
float uvAreaThreshold = chf("UVAreaThreshold");

float error = f@error;

vector2 texcoords[];
vector positions[];
foreach(int point; primpoints(geoself(), @primnum))
{
    vector position = point(geoself(), "P", point);
    append(positions, position);
    vector2 texCoord = point(geoself(), "uv", point);
    texCoord = clamp(texCoord, {0.0, 0.0}, {1.0, 1.0});
    append(texcoords, texCoord);
}


if(error < switchThreshold)
{
    float minc = min(distance(texcoords[0], texcoords[1]), distance(texcoords[1], texcoords[2]), distance(texcoords[2], texcoords[0]));
    if(minc < uvAreaThreshold)
    {
        removeprim(geoself(), @primnum, 1);
    }
}
else
{
    vector v0Pos = positions[0] - positions[1];
    vector v1Pos = positions[2] - positions[1];
    vector n = normalize(cross(v0Pos, v1Pos));
    float d = abs(dot(n, normalize(positions[0])));
    if(d < dotThreshold)
    {
        removeprim(geoself(), @primnum, 1);
    }
}
